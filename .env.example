# Only required for scripts or CI that cannot use Vapi CLI OAuth.
# Never place the real value in this example file.
VAPI_API_KEY=

# HTTPS destination for normalized GTM events (CRM, Make, n8n, or custom adapter).
GTM_WEBHOOK_URL=
GTM_WEBHOOK_SECRET=

# Bearer secret configured on Vapi's server credential and verified by /api/vapi-webhook.
VAPI_WEBHOOK_SECRET=

# HubSpot static/private app token. Required scopes are documented in docs/HUBSPOT_SETUP.md.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_OWNER_ID=

# Mason Nguyen SWELL GTM operating agent. The model defaults to gpt-5.6.
# Keep the API key only in local or platform secret storage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
